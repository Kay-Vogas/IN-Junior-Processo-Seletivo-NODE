// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/@types/prisma"
}

datasource db {
  provider = "postgresql"
}

enum USER_ROLE{
  ADMIN
  DEFAULT
}

model User {
  id  Int @id @default(autoincrement())
  publicId  String @unique @default(uuid(7)) @map("public_id")
  name String
  username String @unique
  email String @unique
  passwordHash String @map("password_hash")
  seats Seat[]
  role USER_ROLE @default(DEFAULT)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Muda o nome da entidade no banco
  @@map("users")
}

model Movie{
  id  Int @id @default(autoincrement())
  publicId  String @unique @default(uuid(7)) @map("public_id")
  title String
  genre String
  ageRating Int
  sessions  Session[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Auxilia na busca por meio de Titulos e Gênero  
  @@index([title])
  @@index([genre])
  
  @@map("movies")
}

model Session{
  id  Int @id @default(autoincrement())
  publicId  String @unique @default(uuid(7)) @map("public_id")
  startTime DateTime @map("start_time")
  seats Seat[]

  movieId Int @map("movie_id")
  movie Movie @relation(fields: [movieId],references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sessions")

}

model Seat{
  id  Int @id @default(autoincrement())
  publicId  String @unique @default(uuid()) @map("public_id")
  number Int
  row String
  price Decimal @db.Decimal()
  isOccupied  Boolean

  userId Int? @map("user_id")
  user User? @relation(fields: [userId],references: [id])

  sessionId Int @map("session_id")
  session Session @relation(fields: [sessionId],references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("seats")
}